{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/about-us/:path*", "destination": "/about", "permanent": true },
    { "source": "/news/:path*", "destination": "/insights", "permanent": true },
    { "source": "/contact-us/:path*", "destination": "/contact", "permanent": true },
    { "source": "/forum/:path*", "destination": "/contact", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/news", "destination": "/insights", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/forum", "destination": "/contact", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
